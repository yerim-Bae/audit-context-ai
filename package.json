{
  "name": "audit-context-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node scripts/build.ts && node scripts/serve.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\" \"seed/**/*.json\" \"*.json\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\" \"seed/**/*.json\" \"*.json\"",
    "dart:check": "node --env-file=.env scripts/dart-check.ts",
    "dart:find": "node --env-file=.env scripts/dart-find.ts",
    "dart:fetch": "node --env-file=.env scripts/dart-fetch.ts",
    "seed:report": "node scripts/seed-report.ts",
    "review": "node scripts/review-tables.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
